<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="github-Project-Surimi" value="https://nuget.pkg.github.com/Project-Surimi/index.json" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <!-- Force these packages to come only from GitHub -->
        <packageSource key="github-Project-Surimi">
            <package pattern="Eii.*" />
        </packageSource>
        <!-- Everything else can come from nuget.org -->
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>